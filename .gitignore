# gaining information. Ignoring it would make that invisible. See README,
# "Where it comes from". rux-ds is not vendored at all since 2026-09-10
# (roadmap §8.4 step 5) -- there is no second regenerable tree to name here.

.DS_Store
node_modules/

# Reserved for generated output. The renderer was decided 2026-08-31 and
# writes tracked pages into guides/; nothing lands here today.
build/

# Claude Code's per-machine permission allowlist. A global ignore file kept it
# out on one Mac and nothing did on the other.
.claude/settings.local.json
