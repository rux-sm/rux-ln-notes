#!/bin/sh
#
# Refuse a commit that would publish something that must not be public.
#
# WHY IT EXISTS. This repository is PUBLIC and served from main, so a push is
# a publication before it is noticed. tools/check-publishable.mjs answers the
# question over the STAGED bytes of every staged page and Markdown file, with
# no exemption and no filename list, and then tools/check.mjs runs every other
# gate. Until 2026-09-01 the privacy gate here was check-export-safe, which
# asked whether a page carried guide data bound for rux-ds -- a question about
# a different repository, answered for one file out of twenty-one because the
# generator stamped every other page exempt. Retired; publishable is the rule.
#
# Install once:  git config core.hooksPath tools/githooks
#
set -eu

cd "$(git rev-parse --show-toplevel)"

# .md AS WELL AS .html. A public repository publishes every tracked file, not
# just the rendered site, and the exchange documents are tracked: SEND-BACK.md
# quoted the PEOPLE tuple literally while a hook that read only pages watched.
# MEASURED IS DERIVED, LIKE A PIN, so it is regenerated and staged here rather
# than remembered. It records the sibling repositories heads and went stale
# on every rux-ds commit while a person was asked to re-run it by hand.
if command -v node >/dev/null 2>&1; then
  node tools/measure.mjs >/dev/null 2>&1 && git add MEASURED
fi

pages=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(html|md)$' || true)
[ -n "$pages" ] || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, so staged pages were NOT checked." >&2
  echo "            This is a refusal, not a pass. Install node. A person may" >&2
  echo "            bypass with --no-verify and must say why in the body;" >&2
  echo "            an agent never does." >&2
  exit 1
fi

# Under .git/ on purpose, and as a REPO-RELATIVE path: the checks resolve
# their targets against the repository root, so an absolute path from mktemp
# is joined onto the root and crashes. Found by testing the refusal rather
# than by reading the script.
tmp=.git/precommit-tmp
rm -rf "$tmp"; mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

# EVERY STAGED PAGE, AS STAGED. The privacy check reads these copies rather
# than the working tree: a gate that checks something other than what is being
# committed is a suggestion.
all=""
for p in $pages; do
  flat=$(printf '%s' "$p" | tr '/' '_')
  git show ":$p" > "$tmp/$flat"
  all="$all $tmp/$flat"
done

# PUBLISHABILITY FIRST, AND WITH NO EXEMPTION. This repository is headed for a
# public remote, so "should this be on the open internet" has to be answered
# before a commit rather than after a push -- a push is public before it is
# noticed.
#
# IT RUNS BEFORE THE EXEMPT FILTER, and that ordering is the whole point. It
# was written after it the first time, below the `[ -n "$targets" ] || exit 0`
# that fires when every staged page is exempt -- and build.mjs stamps
# `EXPORT-SAFE: exempt` into every page it writes, so the check never ran once.
# The commit it was supposed to refuse went through. A public page cannot opt
# out of being public, and an exemption written for a different question must
# not answer this one.
# shellcheck disable=SC2086
if ! node tools/check-publishable.mjs $all; then
  echo "" >&2
  echo "  pre-commit: REFUSED. A staged page carries something that should" >&2
  echo "  not be on the open internet. The fix belongs upstream in atlas --" >&2
  echo "  author it out, do not filter it here." >&2
  exit 1
fi

# THEN EVERY OTHER GATE, over the working tree. The check above reads the
# staged bytes because it is the privacy gate; the rest -- classes, links,
# structure, order, ancestry -- are about whether the site works, and before
# this line they ran only when someone typed them.
node tools/check.mjs || exit 1
